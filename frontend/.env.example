# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Basemap style URL. Defaults to a free OSM raster style
# bundled in the app when unset, so no API key is required to run.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional. Nominatim-compatible geocoder used to resolve state/district/city
# names to polygons for map display. Defaults to the public OSM instance.
NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
